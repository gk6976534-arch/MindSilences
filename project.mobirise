  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "MindSilence™ – Natural Ear & Brain Health Support for a Quieter Mind",
        "meta_descr": "MindSilence™ is presented as a wellness-focused supplement designed to support a calmer mind, mental relaxation, and overall emotional balance. It is intended for people who want to promote a more peaceful daily mindset and better manage the effects of everyday stress. With a blend of carefully selected ingredients, MindSilence™ aims to provide gentle, natural support for mental well-being and relaxation.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
